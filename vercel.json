{
  "routes": [
    {
      "src": "/privacy-policy/?",
      "dest": "/privacy-policy.html"
    },
    {
      "src": "/artikler/?",
      "dest": "/api/articles"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/artikler/([^./]+)",
      "dest": "/api/article?slug=$1"
    },
    {
      "src": "/spill/donkey-kong/(mobil|desktop)/?",
      "dest": "/spill/donkey-kong/$1/index.html"
    },
    {
      "src": "/spill/flipper/(mobil|desktop)/?",
      "dest": "/spill/flipper/$1/index.html"
    },
    {
      "src": "/spill/galaga/(mobil|desktop)/?",
      "dest": "/spill/galaga/$1/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
